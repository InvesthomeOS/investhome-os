# Investhome OS — production environment template
# Copy to .env.production (gitignored) and fill unique values.
# Never commit real secrets. Empty required secrets fail closed at compose interpolate.
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file .env.production config
# Do not pass the development .env file to this compose file.

# -----------------------------------------------------------------------------
# Compose / images
# -----------------------------------------------------------------------------
INVESTHOME_IMAGE_TAG=prod

# -----------------------------------------------------------------------------
# Public hostnames (placeholders only — not a live domain)
# Web origin must match API_CORS_ORIGINS. API URL is what browsers call.
# -----------------------------------------------------------------------------
PRODUCTION_WEB_HOST=web.example.invalid
PRODUCTION_API_HOST=api.example.invalid
NEXT_PUBLIC_SITE_URL=https://web.example.invalid
NEXT_PUBLIC_API_URL=https://api.example.invalid
API_CORS_ORIGINS=["https://web.example.invalid"]
ACME_EMAIL=ops@example.invalid

# Docker frontend network CIDR used by Caddy. Must match docker-compose.prod.yml.
API_TRUSTED_PROXY_IPS=["172.30.0.0/24"]

# -----------------------------------------------------------------------------
# PostgreSQL (REQUIRED SECRET: POSTGRES_PASSWORD)
# -----------------------------------------------------------------------------
POSTGRES_USER=investhome
POSTGRES_PASSWORD=
POSTGRES_DB=investhome

# -----------------------------------------------------------------------------
# Redis (REQUIRED SECRET: REDIS_PASSWORD)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Auth / cookies (REQUIRED SECRETS — unique, >=32 chars, not published placeholders)
# -----------------------------------------------------------------------------
JWT_SECRET=
PORTAL_SESSION_SECRET=
COMMUNICATION_CREDENTIAL_KEY=

# Production compose hardcodes:
# API_ENVIRONMENT=production
# API_DEBUG=false
# API_ENABLE_OPENAPI=false
# API_AUTH_ENABLED=true
# AUTH_COOKIE_SECURE=true
# FEATURE_N8N_AUTOMATION=false
# PUBLIC_FORM_BOT_VERIFY=false
# WordPress S2S website form HMAC. Leave unset until the receiver is wired.
# Never embed this in Elementor/JS. Generate >=32 chars.
# WEBSITE_FORM_INGEST_SECRET=

# Meta WhatsApp Cloud API inbound webhook. Placeholders only — never commit real values.
# Required by production compose (fail-closed). Fill in .env.production, not this file.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Meta Page / Messenger inbound webhook (API container only). Placeholders only.
# Required by production compose for the api service (fail-closed).
# Fill in .env.production, not this file. Do not put real values here.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=

# -----------------------------------------------------------------------------
# User invitation email (optional). Empty SMTP_HOST/SMTP_FROM_EMAIL => not_connected.
# Never put real credentials in this file. APP_PUBLIC_URL should be HTTPS in production.
# Invitation links expire after USER_INVITE_TTL_HOURS (default 168 = 7 days).
# -----------------------------------------------------------------------------
APP_PUBLIC_URL=https://web.example.invalid
# USER_INVITE_TTL_HOURS=168
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=InvestHome OS

# -----------------------------------------------------------------------------
# Optional n8n profile only: docker compose --profile n8n
# REQUIRED unique N8N_BASIC_AUTH_USER / N8N_BASIC_AUTH_PASSWORD / N8N_ENCRYPTION_KEY
# if that profile is used. Empty values and published defaults are rejected at startup.
# No usable default credentials.
# -----------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
