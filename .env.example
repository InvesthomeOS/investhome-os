# Investhome OS — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
COMPOSE_PROJECT_NAME=investhome-os

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Username/database names are not secrets. POSTGRES_PASSWORD must be generated.
# Changing POSTGRES_PASSWORD in this file does not rotate an existing volume —
# ALTER the role inside Postgres, then update dependents.
POSTGRES_USER=investhome
POSTGRES_PASSWORD=
POSTGRES_DB=investhome
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PORT=6379
# REQUIRED unique password. Generate; never commit a real value.
# Compose interpolates this into REDIS_URL for api/worker. Redis requires AUTH.
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# API (FastAPI)
# -----------------------------------------------------------------------------
API_APP_NAME=Investhome OS API
API_APP_VERSION=0.1.0
API_ENVIRONMENT=development
# Explicit override required before demo seed/reset will run when API_ENVIRONMENT=production
# ALLOW_DEMO_SEED_IN_PRODUCTION=true
API_DEBUG=true
API_ENABLE_OPENAPI=true
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Reverse-proxy addresses allowed to set X-Forwarded-For / X-Real-IP.
# Leave empty while the API is exposed directly (current Compose). Do not add
# Cloudflare/CDN ranges until that proxy is actually in front of this service.
API_TRUSTED_PROXY_IPS=
# Public marketing form abuse protection. Do not put real Turnstile secrets here.
# PUBLIC_FORM_BOT_VERIFY=false
# TURNSTILE_SECRET_KEY=
# PUBLIC_FORM_BURST_LIMIT=5
# PUBLIC_FORM_BURST_WINDOW_SECONDS=600
# PUBLIC_FORM_DAILY_LIMIT=20
# PUBLIC_FORM_DAILY_WINDOW_SECONDS=86400
# WordPress server-to-server website form HMAC. Never put this in frontend JS.
# Generate >=32 chars. Endpoint returns 503 until set.
# WEBSITE_FORM_INGEST_SECRET=
# User invitation link lifetime (hours). Raw tokens are never stored.
# USER_INVITE_TTL_HOURS=168
# Public frontend origin used in invitation links (no trailing slash).
# Local default may be http://localhost:3000. Production must be HTTPS.
APP_PUBLIC_URL=http://localhost:3000
# Generic SMTP (no vendor hard-coding). Leave empty until a local/dev relay is configured.
# Never commit real credentials. SMTP_PASSWORD is never logged or returned by the API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=InvestHome OS
# Leave empty here. Compose sets postgresql+psycopg://USER:PASSWORD@postgres:5432/DB at runtime.
DATABASE_URL=

# Auth — REQUIRED. Generate unique values; never commit real secrets.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup fails closed if JWT_SECRET / PORTAL_SESSION_SECRET are unset or are published placeholders.
JWT_SECRET=
# API_AUTH_ENABLED=true
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# JWT_EXPIRE_MINUTES=480
# Portal sessions (HMAC). Required separately from JWT_SECRET.
PORTAL_SESSION_SECRET=
# Local development portal demo login only. Ignored when NODE_ENV=production.
# Never put real or default passwords here.
# PORTAL_DEMO_AUTH=true
# PORTAL_DEMO_EMAIL=
# PORTAL_DEMO_PASSWORD=
# PORTAL_DEMO_EMAIL_B=
# PORTAL_DEMO_PASSWORD_B=
# Dedicated AES-256-GCM key for live Email/WhatsApp tokens at rest.
# Required. Use a unique 32-byte urlsafe-base64 or hex value, or a secret of at least 32 characters.
# Do not reuse JWT_SECRET. Leave unset here — never commit a real key.
# COMMUNICATION_CREDENTIAL_KEY=

# Meta WhatsApp Cloud API inbound webhook. Placeholder only — never commit real values.
# Required in production before enabling the public webhook.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Meta Page / Messenger inbound webhook. Placeholder only — never commit real values.
# Required in production compose for the API service (not worker).
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_PAGE_ID=
# Server-side only. Never expose to the frontend. Required to send Facebook/Instagram DMs.
# META_PAGE_ACCESS_TOKEN=
# Optional Instagram Business account id for inbound DM filtering.
# META_INSTAGRAM_ACCOUNT_ID=

# Security monitoring thresholds (signals only — does not block users or send email/Slack).
# SECURITY_MONITOR_WINDOW_SECONDS=900
# SECURITY_MONITOR_FAILED_LOGIN_BURST=5
# SECURITY_MONITOR_FAILED_LOGIN_CRITICAL=15
# SECURITY_MONITOR_MULTI_ACCOUNT=3
# SECURITY_MONITOR_MULTI_ACCOUNT_CRITICAL=8
# SECURITY_MONITOR_MFA_BURST=5
# SECURITY_MONITOR_CSRF_BURST=8
# SECURITY_MONITOR_WEBHOOK_BURST=5
# SECURITY_MONITOR_DOCUMENT_DENIED_BURST=8
# Optional correlation pepper. Leave empty to derive from JWT_SECRET. Never commit a real value.
# SECURITY_MONITOR_PEPPER=

# Gmail mailbox OAuth (pilot) reuses GOOGLE_DRIVE_CLIENT_ID / GOOGLE_DRIVE_CLIENT_SECRET.
# Do not reuse GOOGLE_DRIVE_REFRESH_TOKEN for Gmail — that token is Drive-only.
# Register this exact redirect URI on the Google Cloud OAuth client, enable Gmail API,
# and add gmail.readonly + userinfo.email to the consent screen.
# GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/crm/settings/communication-accounts/gmail/callback
# GMAIL_SYNC_ENABLED=true
# GMAIL_SYNC_INTERVAL_MINUTES=5
# GMAIL_BACKFILL_DAYS=30

# Document storage (local filesystem in development; S3/GCS/Azure ready)
DOCUMENT_STORAGE_ROOT=/var/lib/investhome/documents
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_MAX_UPLOAD_BYTES=52428800

# -----------------------------------------------------------------------------
# Web (Next.js)
# -----------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Public website (P7) — analytics & lead form slugs (never hardcode secrets)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_SITE_FORM_CONSULTATION=site-consultation
NEXT_PUBLIC_SITE_FORM_GUIDE=site-guide-download
NEXT_PUBLIC_SITE_FORM_BROCHURE=site-brochure
NEXT_PUBLIC_SITE_FORM_ANALYSIS=site-investment-analysis
NEXT_PUBLIC_SITE_FORM_NEWSLETTER=site-newsletter
NEXT_PUBLIC_SITE_FORM_MEETING=site-schedule-meeting
NEXT_PUBLIC_SITE_FORM_CALCULATOR=site-calculator-lead
NEXT_PUBLIC_SITE_FORM_CONTACT=site-contact

# -----------------------------------------------------------------------------
# n8n Automation
# -----------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
# Required unique values when the n8n service is started. No published defaults.
# Do not use admin/changeme.
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
# n8n credential encryption — REQUIRED unique value (generate; never use a placeholder)
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_DISABLED=false
N8N_DIAGNOSTICS_ENABLED=false

# Feature flags (enable/disable modules without code changes)
FEATURE_COMPANY_FOUNDATION=true
FEATURE_DOCUMENT_INTELLIGENCE=true
FEATURE_DRAWING_INTELLIGENCE=true
FEATURE_UNIVERSAL_SEARCH=true
FEATURE_NOTIFICATION_CENTER=true
FEATURE_ACTIVITY_LOG=true
FEATURE_EXECUTIVE_DASHBOARD=true
FEATURE_N8N_AUTOMATION=false
FEATURE_EXTERNAL_AI=false
FEATURE_EXTERNAL_STORAGE=false

# Leave empty here. Compose sets redis://:<REDIS_PASSWORD>@redis:6379/0 at runtime.
REDIS_URL=
DOCUMENT_PROCESSING_SYNC=false
DOCUMENT_PROCESSING_MAX_RETRIES=3
# LLM provider (fail-closed for external providers — no silent OpenAI→mock fallback).
# Explicit mock/local aliases: mock | local | fake | hash | heuristic
# Real providers: openai (requires AI_API_KEY) | azure_openai (AI_API_KEY + AI_AZURE_*)
AI_PROVIDER=local
AI_MODEL=local-heuristic-v1
# Placeholder only — never commit a real key. Required when AI_PROVIDER=openai|azure_openai.
AI_API_KEY=
# AI_BASE_URL=
# AI_AZURE_ENDPOINT=
# AI_AZURE_DEPLOYMENT=
# AI_AZURE_API_VERSION=2024-02-01
# Example real OpenAI (uncomment + set key in local .env only):
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o
# AI_API_KEY=
AI_ASSISTANT_RETRIEVAL_LIMIT=8
AI_ASSISTANT_MIN_SCORE=0.12
AI_ASSISTANT_MAX_PROMPT_CHARS=12000
AI_ALLOW_EXTERNAL_FOR_CONFIDENTIAL=false
AI_ALLOW_EXTERNAL_FOR_HIGHLY_CONFIDENTIAL=false
OCR_PROVIDER=local
DOCUMENT_QA_HISTORY_RETENTION_DAYS=90

# Ideogram External Design AI POC (Creative Studio SMB only).
# Placeholder only — never commit a real key. Required for live remix generation.
# Add the real key to gitignored repo-root .env, then restart api.
IDEOGRAM_API_KEY=
IDEOGRAM_ENABLED=true
IDEOGRAM_MODEL=V_4_0
IDEOGRAM_DEFAULT_QUALITY=QUALITY

# GPT Image (OpenAI Images API) for Social Media Builder visual generation.
# Reuses AI_API_KEY. Model default verified from official OpenAI docs: gpt-image-2.
GPT_IMAGE_ENABLED=true
GPT_IMAGE_MODEL=gpt-image-2
GPT_IMAGE_QUALITY=medium

# Canva Connect OAuth 2.0 + PKCE (platform integrations).
# Placeholder only — never commit real credentials.
# Redirect URI registered in Canva Developer Portal must be exactly:
# http://127.0.0.1:8000/platform/integrations/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Security / Enterprise Admin (P11) — adapters; leave blank until connected
# -----------------------------------------------------------------------------
MFA_ENFORCEMENT=optional
MFA_TOTP_ISSUER=InvestHomeOS
MFA_EMAIL_ENABLED=false
MFA_RECOVERY_ENABLED=false

# SSO adapters (status surfaces as Missing until all required keys are set)
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_OKTA_DOMAIN=
SSO_OKTA_CLIENT_ID=
SSO_OKTA_CLIENT_SECRET=
SSO_AZURE_TENANT_ID=
SSO_AZURE_CLIENT_ID=
SSO_AZURE_CLIENT_SECRET=
SSO_SAML_METADATA_URL=
SSO_SAML_ENTITY_ID=

# Optional secret managers (status only — values never returned by API)
VAULT_ADDR=
VAULT_TOKEN=
AWS_SECRETS_REGION=
AZURE_KEYVAULT_URL=

# Backup readiness reporting only. BACKUP_PROVIDER names a future adapter;
# it cannot mark backups verified. No live production backup provider is connected.
BACKUP_PROVIDER=none
BACKUP_FRESHNESS_HOURS=24

# -----------------------------------------------------------------------------
# Knowledge Hub optional providers (honest unavailable when unset)
# -----------------------------------------------------------------------------
# VECTOR_STORE_PROVIDER=pgvector
# VECTOR_STORE_URL=
# EMBEDDING_API_KEY=
# MALWARE_SCAN_PROVIDER=
# MALWARE_SCAN_ENDPOINT=
# MALWARE_SCAN_API_KEY=
# EXTERNAL_SHARE_SIGNING_KEY=
# EXTERNAL_SHARE_BASE_URL=
# PUBLIC_WEBSITE_API_URL=
